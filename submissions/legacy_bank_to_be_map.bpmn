<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1rtz0du" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:collaboration id="Collaboration_0e9loob">
    <bpmn:participant id="Participant_1y5yedg" name="To-Be Collections Proceess" processRef="Process_0f4lm29" />
    <bpmn:participant id="Participant_03mm76p" processRef="Process_0zss99e" />
    <bpmn:participant id="Participant_1l7776s" processRef="Process_1pdenkh" />
    <bpmn:textAnnotation id="TextAnnotation_0wvkh3t">
      <bpmn:text>One storage for all customer data eliminating pain point of having to check multiple sources</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_06l4ewi" associationDirection="None" sourceRef="Participant_1y5yedg" targetRef="TextAnnotation_0wvkh3t" />
    <bpmn:textAnnotation id="TextAnnotation_125h2gp">
      <bpmn:text>Automated reminder service pushes more customers towards self-service portal</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:group id="Group_1snf9tv" categoryValueRef="CategoryValue_0t4w32z" />
    <bpmn:textAnnotation id="TextAnnotation_0ysikvg">
      <bpmn:text>Automated customer verification loop eliminates need for humans for simple cases and if it fails it reroutes to a representative</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1e8n03n" associationDirection="None" sourceRef="Group_1snf9tv" targetRef="TextAnnotation_0ysikvg" />
    <bpmn:group id="Group_0jsd213" categoryValueRef="CategoryValue_06trsld" />
    <bpmn:textAnnotation id="TextAnnotation_0opyvzl">
      <bpmn:text>Automatic payment and payment plan selection takes many cases out of the hands of reps.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_08i48se" associationDirection="None" sourceRef="Group_0jsd213" targetRef="TextAnnotation_0opyvzl" />
    <bpmn:textAnnotation id="TextAnnotation_0j77lq0">
      <bpmn:text>Automatic follow ups created which are only escalated to a human if promise is not met. Removes old manual handling which was prone to errors.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_10tq4x7">
      <bpmn:text>Automatic payment fulfillment check ensures correctness and removes manual work</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1sis9o4" associationDirection="None" sourceRef="TextAnnotation_10tq4x7" targetRef="Participant_1y5yedg" />
    <bpmn:association id="Association_0rvrgsz" associationDirection="None" sourceRef="TextAnnotation_10tq4x7" targetRef="Participant_1y5yedg" />
    <bpmn:textAnnotation id="TextAnnotation_07ebt5t">
      <bpmn:text>Automatically attaches needed details to case sent to rep. Removes manual work of retrieving details.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_02s1awy">
      <bpmn:text>Automatic identity verification reduces work time</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0bzgbai">
      <bpmn:text>Exception path for customer abandonment. Cases go back to automatic monitoring until payment deadline when human takes over.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_10opz8n" associationDirection="None" sourceRef="Flow_0hpfoff" targetRef="TextAnnotation_0bzgbai" />
    <bpmn:textAnnotation id="TextAnnotation_03ir7ls">
      <bpmn:text>Exception path for cases which are not eligible for customer self-service. Goes straight through to human rep.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0bcvyfo" associationDirection="None" sourceRef="Flow_0e8xbh8" targetRef="TextAnnotation_03ir7ls" />
    <bpmn:textAnnotation id="TextAnnotation_1wkjrjz">
      <bpmn:text>Exception path for failed verification. Customer can retry if not blocked for security reasons.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1hvgo89" associationDirection="None" sourceRef="Flow_1dpo6mq" targetRef="TextAnnotation_1wkjrjz" />
    <bpmn:textAnnotation id="TextAnnotation_158kdec">
      <bpmn:text>Exception point for customer abandonment. If customer abandons self-service at any point before completion then reroute case here.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_03obmhl">
      <bpmn:text>Exception path for unsuccessful payment. Customer can retry and enter self-service process again from the start or escalate to human rep.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0ypm732" associationDirection="None" sourceRef="Flow_0nccx1f" targetRef="TextAnnotation_03obmhl" />
    <bpmn:textAnnotation id="TextAnnotation_0eb7wwb">
      <bpmn:text>Exception path for promised payment not arriving before reminder threshold. Reminder threshold TBD. Customer is sent automatic reminder.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_013nryz" associationDirection="None" sourceRef="Flow_0crt6do" targetRef="TextAnnotation_0eb7wwb" />
    <bpmn:textAnnotation id="TextAnnotation_0mgmt7j">
      <bpmn:text>Exception path for promised payment not being made in time. Case escalated with details attached to human rep.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0vi2awr" associationDirection="None" sourceRef="Flow_1d6boj6" targetRef="TextAnnotation_0mgmt7j" />
    <bpmn:textAnnotation id="TextAnnotation_1l1g48e">
      <bpmn:text>Exception path for unsuccessful contact. Contact attempt is logged and if it exceeds a threshold (TBD) the case is escalated to a manager.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_01rkr3e" associationDirection="None" sourceRef="Flow_1l2qcym" targetRef="TextAnnotation_1l1g48e" />
    <bpmn:textAnnotation id="TextAnnotation_17hk7c4">
      <bpmn:text>Exception path for customer being unable to give the right details to verify themselves. Contact attempt is logged and if needed the case is escalated to a manager.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0d6e8rn" associationDirection="None" sourceRef="Flow_03gvu9r" targetRef="TextAnnotation_17hk7c4" />
    <bpmn:textAnnotation id="TextAnnotation_1hcvwjg">
      <bpmn:text>Exception path if case needs to be escalated for any reason such as uncooperative customer or unique hardships. Passed off to manager.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ajrx7j" associationDirection="None" sourceRef="Flow_1gpj7no" targetRef="TextAnnotation_1hcvwjg" />
    <bpmn:group id="Group_1i3j4ok" categoryValueRef="CategoryValue_0ncprqv" />
    <bpmn:textAnnotation id="TextAnnotation_0r30b4l">
      <bpmn:text>Automated Process</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0dwkog5" associationDirection="None" sourceRef="Participant_03mm76p" targetRef="TextAnnotation_0r30b4l" />
    <bpmn:textAnnotation id="TextAnnotation_1o175dd">
      <bpmn:text>Manual Process</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1wij4i8" associationDirection="None" sourceRef="Participant_1l7776s" targetRef="TextAnnotation_1o175dd" />
    <bpmn:group id="Group_0y2oytg" categoryValueRef="CategoryValue_136lif4" />
    <bpmn:textAnnotation id="TextAnnotation_14bsn00">
      <bpmn:text>Group of automated processes forming a single flow</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_09fo7u9" associationDirection="None" sourceRef="Group_0y2oytg" targetRef="TextAnnotation_14bsn00" />
    <bpmn:textAnnotation id="TextAnnotation_09ngbjc">
      <bpmn:text>Green annotations mark a new step in the process and what problem it solves.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1tlougo">
      <bpmn:text>Red annotations mark explicit exception paths.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ustefm">
      <bpmn:text>Exception path for cases which need compliance review. Rep passes it off to manager review who can escalate to compliance team.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_17ceou2" associationDirection="None" sourceRef="Flow_10hvp33" targetRef="TextAnnotation_0ustefm" />
    <bpmn:textAnnotation id="TextAnnotation_0frmwzn">
      <bpmn:text>Collections management need to decide on a retry threshold for escalation. A lower value leads to higher management workload, conversely a higher value leads to more rep time wasted on failing to contact</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1bxpd16">
      <bpmn:text>Which cases need to be escalated is a decision for the collections management.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0c3hdo4">
      <bpmn:text>How to classify the needs of a case is the responsibility of the collections team and is not in scope for this project</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_09g8a6p">
      <bpmn:text>Rules for how many times a customer can retry automatic verification is a decision that need to be made by the compliance team.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_09ze3r9">
      <bpmn:text>Blue annotations give more information on relevant business rules or assumptions made.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0bz6x45" associationDirection="None" sourceRef="Activity_06neohu" targetRef="TextAnnotation_125h2gp" />
    <bpmn:association id="Association_0lkw6wt" associationDirection="None" sourceRef="Activity_1ap2gy4" targetRef="TextAnnotation_0j77lq0" />
    <bpmn:association id="Association_0jytr1c" associationDirection="None" sourceRef="Event_0i2p955" targetRef="TextAnnotation_10tq4x7" />
    <bpmn:association id="Association_098u55y" associationDirection="None" sourceRef="Activity_19p3133" targetRef="TextAnnotation_07ebt5t" />
    <bpmn:association id="Association_0yvfokk" associationDirection="None" sourceRef="Activity_1fxr0x4" targetRef="TextAnnotation_02s1awy" />
    <bpmn:association id="Association_0jc2dn1" associationDirection="None" sourceRef="Event_1udxgan" targetRef="TextAnnotation_158kdec" />
    <bpmn:association id="Association_1nxb2xu" associationDirection="None" sourceRef="Gateway_1vvkhnr" targetRef="TextAnnotation_0frmwzn" />
    <bpmn:association id="Association_0lneel7" associationDirection="None" sourceRef="Gateway_0a2ql4q" targetRef="TextAnnotation_1bxpd16" />
    <bpmn:association id="Association_1s0y5pc" associationDirection="None" sourceRef="Gateway_1m1wsww" targetRef="TextAnnotation_0c3hdo4" />
    <bpmn:association id="Association_1adqe6e" associationDirection="None" sourceRef="Gateway_1qpydzx" targetRef="TextAnnotation_09g8a6p" />
    <bpmn:textAnnotation id="TextAnnotation_0ykrxr6">
      <bpmn:text>This process relies on old data from the legacy database, spreadsheets and email trackers being migrated over to the new centralised database.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_03lrqko" associationDirection="None" sourceRef="Participant_1y5yedg" targetRef="TextAnnotation_0ykrxr6" />
    <bpmn:textAnnotation id="TextAnnotation_0w3bf5d">
      <bpmn:text>This represents a hand off to a manager process which is out of scope for this project. Due to the new database structure when cases are handed off they will include all relevant customer information.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1ll1dqb" associationDirection="None" sourceRef="Event_1wigldx" targetRef="TextAnnotation_0w3bf5d" />
    <bpmn:textAnnotation id="TextAnnotation_171fi73">
      <bpmn:text>Automated payment reminder increases use of self-service portal and reduces human case load.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_08h9ky1" associationDirection="None" sourceRef="Activity_1fzqbmo" targetRef="TextAnnotation_171fi73" />
  </bpmn:collaboration>
